# Settings for the full stack (edge cache + observability), used by the CI and the e2e suite:
#   docker compose --env-file stack-full.env --profile edge --profile observability up --build --wait

# The gateway sends PURGE to Varnish on article events (needs the edge profile).
NEWSCORE_VARNISH_PURGE_ENABLED=true
# JSON log lines with traceId/spanId for Loki (needs the observability profile).
NEWSCORE_GATEWAY_PROFILES=elasticsearch,kafka,json
# Export every trace to Tempo (needs the observability profile).
NEWSCORE_TRACING_SAMPLING=1.0
