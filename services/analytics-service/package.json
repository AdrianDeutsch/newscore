{
  "name": "@newscore/analytics-service",
  "version": "0.1.0",
  "private": true,
  "description": "Kafka consumer that records NewsCore search and page-view analytics into PostgreSQL",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "dev": "tsc -p tsconfig.json && node dist/index.js",
    "lint": "eslint .",
    "test:unit": "vitest",
    "test:integration": "vitest run --config vitest.integration.config.ts"
  },
  "dependencies": {
    "@kafkajs/confluent-schema-registry": "^4.1.0",
    "kafkajs": "^2.2.4",
    "pg": "^8.13.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@testcontainers/postgresql": "^12.2.1",
    "@types/node": "^22.8.0",
    "@types/pg": "^8.11.10",
    "@vitest/coverage-v8": "^4.1.9",
    "eslint": "^10.15.0",
    "globals": "^17.14.0",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.12.2",
    "vitest": "^4.1.9"
  },
  "overrides": {
    "minimatch@>=7.0.0 <11.0.1": "^11.0.9",
    "glob@>=9.0.0 <=14.0.1": "^14.0.6"
  }
}
